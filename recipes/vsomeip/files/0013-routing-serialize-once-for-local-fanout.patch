From 8072aa9597ac17551f7c94db92ba80dce9640a46 Mon Sep 17 00:00:00 2001
From: Yunqiang Hu <yunhu@qti.qualcomm.com>
Date: Thu, 14 May 2026 15:46:16 +0800
Subject: [PATCH] routing: serialize once for local fanout

Description: Serialize payload once for all local subscribers to reduce CPU cost.
Signed-off-by: Yunqiang Hu <yunhu@qti.qualcomm.com>
---
 .../routing/src/routing_manager_base.cpp      | 32 +++++++++++++++++--
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/implementation/routing/src/routing_manager_base.cpp b/implementation/routing/src/routing_manager_base.cpp
index 14ec4687..feefd92f 100644
--- a/implementation/routing/src/routing_manager_base.cpp
+++ b/implementation/routing/src/routing_manager_base.cpp
@@ -1337,7 +1337,33 @@ bool routing_manager_base::send_local_notification(client_t _client,
 
     std::shared_ptr<event> its_event = find_event(its_service, _instance, its_method);
     if (its_event && !its_event->is_shadow()) {
-        for (auto its_client : its_event->get_filtered_subscribers(_force)) {
+        auto its_subscribers = its_event->get_filtered_subscribers(_force);
+        if (its_subscribers.empty()) {
+            return has_remote;
+        }
+
+        // Serialize the notification command once for all local subscribers.
+        // All local subscribers receive identical wire bytes — avoid repeating
+        // the two internal payload copies (set_message + serialize) per subscriber.
+        std::shared_ptr<std::vector<byte_t>> its_shared_buffer;
+        {
+            protocol::send_command its_command(protocol::id_e::SEND_ID);
+            its_command.set_client(get_client());
+            its_command.set_instance(_instance);
+            its_command.set_reliable(_reliable);
+            its_command.set_status(_status_check);
+            its_command.set_target(_client);
+            its_command.set_message(std::vector<byte_t>(_data, _data + _size));
+            auto buf = std::make_shared<std::vector<byte_t>>();
+            protocol::error_e its_error;
+            its_command.serialize(*buf, its_error);
+            if (its_error != protocol::error_e::ERROR_OK) {
+                return has_remote;
+            }
+            its_shared_buffer = std::move(buf);
+        }
+
+        for (auto its_client : its_subscribers) {
 
             // local
             if (its_client == VSOMEIP_ROUTING_CLIENT) {
@@ -1352,8 +1378,8 @@ bool routing_manager_base::send_local_notification(client_t _client,
 
             std::shared_ptr<endpoint> its_local_target = ep_mgr_->find_local(its_client);
             if (its_local_target) {
-                send_local(its_local_target, _client, _data, _size,
-                           _instance, _reliable, protocol::id_e::SEND_ID, _status_check);
+                its_local_target->send(its_shared_buffer->data(),
+                                       uint32_t(its_shared_buffer->size()));
             }
         }
     }
-- 
