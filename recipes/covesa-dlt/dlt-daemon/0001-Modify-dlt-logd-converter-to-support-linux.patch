From: Andrew Zhao <quic_zhax@quicinc.com>
Date: Mon, 27 Nov 2023 16:55:46 +0800
Subject: [PATCH] Modify dlt-logd-converter to support linux

---
 include/dlt/dlt-logd-converter.hpp | 16 +-----------
 src/CMakeLists.txt                 |  1 +
 src/android/CMakeLists.txt         | 17 ++++++++++++
 src/android/dlt-logd-converter.cpp | 42 ++++++++++++++++++++++--------
 4 files changed, 50 insertions(+), 26 deletions(-)
 create mode 100644 src/android/CMakeLists.txt

diff --git a/include/dlt/dlt-logd-converter.hpp b/include/dlt/dlt-logd-converter.hpp
index 0959a8f..d636b32 100644
--- a/include/dlt/dlt-logd-converter.hpp
+++ b/include/dlt/dlt-logd-converter.hpp
@@ -50,7 +50,6 @@
 #ifndef DLT_UNIT_TESTS
 #   include <log/log_read.h>
 #   include <log/logprint.h>
-#   include <json/json.h>
 #endif
 
 #include <fstream>
@@ -62,7 +61,7 @@
 using namespace std;
 
 /* MACRO */
-#define CONFIGURATION_FILE_DIR "/vendor/etc/dlt-logd-converter.conf"
+#define CONFIGURATION_FILE_DIR "/etc/dlt-logd-converter.conf"
 #define JSON_FILE_DIR "/vendor/etc/dlt-logdctxt.json"
 #define MAX_LINE 1024
 #define DLT_FAIL_TO_GET_LOG_MSG 0
@@ -180,7 +179,6 @@ struct dlt_log_container {
 };
 
 /* Android API faked method for unit test */
-string t_load_json_file();
 struct logger *t_android_logger_open(logger_list *logger_list,log_id_t log_id);
 struct logger_list *t_android_logger_list_alloc(int mode, unsigned int tail, pid_t pid);
 int t_android_logger_list_read(logger_list *logger_list, log_msg *t_log_msg);
@@ -212,18 +210,6 @@ DLT_STATIC int load_configuration_file(const char *file_name);
  * @return void
  */
 DLT_STATIC void clean_mem();
-/**
- * Parses data from a JSON file into an internal data
- * structure and do registration with the new ctxID.
- * @return void
- */
-DLT_STATIC void json_parser();
-/**
- * Doing tag matching for pairs in JSON unordered map.
- * @param tag tag of the application that needs new context ID
- * @return pointer to DLT context mapped with the corresponding tag
- */
-DLT_STATIC DltContext* find_tag_in_json(const char *tag);
 /**
  * Doing initialization for logger.
  * @param logger_list pointer to a logger list struct
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 1f000a1..776150e 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -27,6 +27,7 @@ endif( WITH_DLT_EXAMPLES )
 
 if( WITH_DLT_ADAPTOR_STDIN OR WITH_DLT_ADAPTOR_UDP OR WITH_DLT_ADAPTOR )
     add_subdirectory( adaptor )
+    add_subdirectory( android )
 endif( WITH_DLT_ADAPTOR_STDIN OR WITH_DLT_ADAPTOR_UDP OR WITH_DLT_ADAPTOR )
 
 if( WITH_DLT_TESTS )
diff --git a/src/android/CMakeLists.txt b/src/android/CMakeLists.txt
new file mode 100644
index 0000000..e22c23f
--- /dev/null
+++ b/src/android/CMakeLists.txt
@@ -0,0 +1,17 @@
+include_directories(
+	${PROJECT_SOURCE_DIR}/
+	${PROJECT_SOURCE_DIR}/include/dlt
+)
+
+set(dlt_logd_converter_SRCS dlt-logd-converter.cpp)
+add_executable(dlt-logd-converter ${dlt_logd_converter_SRCS})
+target_link_libraries(dlt-logd-converter dlt log)
+set_target_properties(dlt-logd-converter PROPERTIES LINKER_LANGUAGE CXX)
+
+install(TARGETS dlt-logd-converter
+	RUNTIME DESTINATION bin
+	COMPONENT base)
+
+INSTALL(FILES dlt-logd-converter.conf
+	DESTINATION ${CONFIGURATION_FILES_DIR}
+	COMPONENT base)
diff --git a/src/android/dlt-logd-converter.cpp b/src/android/dlt-logd-converter.cpp
index 657310f..42cc1ea 100644
--- a/src/android/dlt-logd-converter.cpp
+++ b/src/android/dlt-logd-converter.cpp
@@ -45,16 +45,16 @@ DLT_DECLARE_CONTEXT(dlt_ctx_rdio)
 DLT_DECLARE_CONTEXT(dlt_ctx_evnt) /* Binary Buffer */
 DLT_DECLARE_CONTEXT(dlt_ctx_syst)
 DLT_DECLARE_CONTEXT(dlt_ctx_crsh)
-DLT_DECLARE_CONTEXT(dlt_ctx_stat) /* Binary Buffer */
-DLT_DECLARE_CONTEXT(dlt_ctx_secu) /* Binary Buffer */
+//DLT_DECLARE_CONTEXT(dlt_ctx_stat) /* Binary Buffer */
+//DLT_DECLARE_CONTEXT(dlt_ctx_secu) /* Binary Buffer */
 DLT_DECLARE_CONTEXT(dlt_ctx_krnl)
-DLT_DECLARE_CONTEXT(dlt_ctx_othe)
+//DLT_DECLARE_CONTEXT(dlt_ctx_othe)
 
 /* Global variables */
 DLT_STATIC dlt_logd_configuration *logd_conf = nullptr;
 volatile sig_atomic_t exit_parser_loop = false;
-DLT_STATIC unordered_map<string, DltContext*> map_ctx_json;
-bool json_is_available = false;
+//DLT_STATIC unordered_map<string, DltContext*> map_ctx_json;
+//bool json_is_available = false;
 
 /**
  * Print manual page for instruction.
@@ -214,6 +214,7 @@ DLT_STATIC void clean_mem()
         delete logd_conf;
         logd_conf = nullptr;
     }
+#if 0
     if (json_is_available) {
         for (auto &map_malloc: map_ctx_json) {
             delete map_malloc.second;
@@ -221,8 +222,10 @@ DLT_STATIC void clean_mem()
         }
         map_ctx_json.clear();
     }
+#endif
 }
 
+#if 0
 /**
  * Parses data from a json file into an internal data
  * structure and do registration with the new ctxID.
@@ -312,6 +315,7 @@ DLT_STATIC DltContext* find_tag_in_json(const char *tag)
         return search->second;
     }
 }
+#endif
 
 DLT_STATIC struct logger *init_logger(struct logger_list *logger_list, log_id_t log_id)
 {
@@ -355,8 +359,8 @@ DLT_STATIC struct logger_list *init_logger_list(bool skip_binary_buffers)
 
     if (!skip_binary_buffers) {
         init_logger(logger_list, LOG_ID_EVENTS);
-        init_logger(logger_list, LOG_ID_STATS);
-        init_logger(logger_list, LOG_ID_SECURITY);
+        //init_logger(logger_list, LOG_ID_STATS);
+        //init_logger(logger_list, LOG_ID_SECURITY);
     }
 
     return logger_list;
@@ -376,10 +380,12 @@ DLT_STATIC DltContext *get_log_context_from_log_msg(struct log_msg *log_msg)
             return &dlt_ctx_syst;
         case LOG_ID_CRASH:
             return &dlt_ctx_crsh;
+#if 0
         case LOG_ID_STATS:
             return &dlt_ctx_stat;
         case LOG_ID_SECURITY:
             return &dlt_ctx_secu;
+#endif
         case LOG_ID_KERNEL:
             return &dlt_ctx_krnl;
         default:
@@ -490,6 +496,7 @@ DLT_STATIC int logd_parser_loop(struct logger_list *logger_list)
             message = tag + strlen(tag) + 1;
         }
 
+#if 0
         /* Find tag in JSON file, apply new contextID if available */
         if ((log_msg.id() == LOG_ID_MAIN) && (json_is_available)) {
             ctx = find_tag_in_json(tag);
@@ -497,6 +504,8 @@ DLT_STATIC int logd_parser_loop(struct logger_list *logger_list)
         else {
             ctx = get_log_context_from_log_msg(&log_msg);
         }
+#endif
+        ctx = get_log_context_from_log_msg(&log_msg);
 
         DltLogLevelType log_level = get_log_level_from_log_msg(&log_msg);
 
@@ -548,10 +557,11 @@ int main(int argc, char *argv[])
     DLT_REGISTER_CONTEXT(dlt_ctx_krnl, "KRNL", "logd type: krnl");
     if (!skip_binary_buffers) {
         DLT_REGISTER_CONTEXT(dlt_ctx_evnt, "EVNT", "logd type: evnt");
-        DLT_REGISTER_CONTEXT(dlt_ctx_stat, "STAT", "logd type: stat");
-        DLT_REGISTER_CONTEXT(dlt_ctx_secu, "SECU", "logd type: secu");
+        //DLT_REGISTER_CONTEXT(dlt_ctx_stat, "STAT", "logd type: stat");
+        //DLT_REGISTER_CONTEXT(dlt_ctx_secu, "SECU", "logd type: secu");
     }
 
+#if 0
     /* Parse json data into internal data structure and do registration */
     json_parser();
     if (json_is_available) {
@@ -567,6 +577,12 @@ int main(int argc, char *argv[])
                         DLT_STRING(". Extension is OFF!"));
         DLT_REGISTER_CONTEXT(dlt_ctx_main, "MAIN", "logd type: main");
     }
+#endif
+    DLT_LOG(dlt_ctx_self, DLT_LOG_INFO,
+            DLT_STRING("No JSON file available at "),
+            DLT_STRING(logd_conf->json_file_dir);
+            DLT_STRING(". Extension is OFF!"));
+    DLT_REGISTER_CONTEXT(dlt_ctx_main, "MAIN", "logd type: main");
 
     struct sigaction act;
     act.sa_handler = signal_handler;
@@ -595,10 +611,11 @@ int main(int argc, char *argv[])
     DLT_UNREGISTER_CONTEXT(dlt_ctx_self);
     if (!skip_binary_buffers) {
         DLT_UNREGISTER_CONTEXT(dlt_ctx_evnt);
-        DLT_UNREGISTER_CONTEXT(dlt_ctx_stat);
-        DLT_UNREGISTER_CONTEXT(dlt_ctx_secu);
+        //DLT_UNREGISTER_CONTEXT(dlt_ctx_stat);
+        //DLT_UNREGISTER_CONTEXT(dlt_ctx_secu);
     }
 
+#if 0
     if (json_is_available) {
         DLT_UNREGISTER_CONTEXT(dlt_ctx_othe);
         for (auto &tag_map: map_ctx_json) {
@@ -608,6 +625,9 @@ int main(int argc, char *argv[])
 	else {
         DLT_UNREGISTER_CONTEXT(dlt_ctx_main);
     }
+#endif
+    DLT_UNREGISTER_CONTEXT(dlt_ctx_main);
+
     DLT_UNREGISTER_APP_FLUSH_BUFFERED_LOGS();
     clean_mem();
     return ret;
