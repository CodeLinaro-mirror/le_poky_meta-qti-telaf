[Unit]
Description=Start TelAF APPs
Requires=telaf.service
After=telaf.service
Conflicts=shutdown.target
DefaultDependencies=no
ConditionKernelCommandLine=systemd.setenv

[Service]
Type=oneshot
ExecStart=sh -c '/etc/initscripts/start_telaf.sh startGroup'
ExecStop=sh -c '/etc/initscripts/start_telaf.sh stopGroup'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
